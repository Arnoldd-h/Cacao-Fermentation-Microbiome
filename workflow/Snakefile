configfile: "config/config.yaml"

include: "rules/pilot_qc.smk"


rule all:
    input:
        "metadata/.inventory.ok",
        "metadata/discovery_candidates.tsv",
        "results/tables/pilot_dataset_selection.tsv",
        "metadata/pilot_manifest.tsv"


rule discover_candidates:
    input:
        project_config="config/config.yaml",
        datasets="config/datasets.yaml",
    output:
        "metadata/discovery_candidates.tsv"
    shell:
        "python scripts/metadata/discover_candidates.py"


rule build_inventory:
    input:
        project_config="config/config.yaml",
        datasets="config/datasets.yaml",
    output:
        studies="metadata/studies.tsv",
        runs="metadata/runs.tsv",
        samples="metadata/samples.tsv",
        exclusions="metadata/exclusion_log.tsv",
    shell:
        "python scripts/metadata/build_inventory.py"


rule validate_inventory:
    input:
        rules="config/config.yaml",
        studies="metadata/studies.tsv",
        runs="metadata/runs.tsv",
        samples="metadata/samples.tsv",
        exclusions="metadata/exclusion_log.tsv",
    output:
        "metadata/.inventory.ok"
    shell:
        "python scripts/metadata/validate_metadata.py --stamp {output}"


rule select_pilot_dataset:
    input:
        config="config/config.yaml",
        studies="metadata/studies.tsv",
        runs="metadata/runs.tsv",
        samples="metadata/samples.tsv",
    output:
        "results/tables/pilot_dataset_selection.tsv"
    shell:
        "python scripts/metadata/select_pilot_dataset.py --output {output}"


rule build_pilot_manifest:
    input:
        config="config/config.yaml",
        selection="results/tables/pilot_dataset_selection.tsv",
        runs="metadata/runs.tsv",
        samples="metadata/samples.tsv",
    output:
        "metadata/pilot_manifest.tsv"
    shell:
        "python scripts/metadata/build_pilot_manifest.py --selection {input.selection} --output {output}"


rule download_pilot_fastq:
    input:
        config="config/config.yaml",
        manifest="metadata/pilot_manifest.tsv",
    output:
        "results/qc/pilot_download_validation.tsv"
    shell:
        "python scripts/metadata/download_pilot_fastq.py --manifest {input.manifest} --report {output}"


rule validate_pilot_fastq:
    input:
        "results/qc/pilot_download_validation.tsv"
    output:
        "results/qc/pilot_fastq_validation.tsv"
    shell:
        "python scripts/metadata/validate_pilot_fastq.py --download-report {input} --output {output}"
